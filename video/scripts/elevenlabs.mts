// ElevenLabs helper for the demo narration. The key is read from the repo's .env inside this
// script and never printed (AGENTS rule 6).
//
//   node scripts/elevenlabs.mts info              plan, characters used and left (no cost)
//   node scripts/elevenlabs.mts voices            voices on the account (no cost)
//   node scripts/elevenlabs.mts models            text-to-speech models (no cost)
//   node scripts/elevenlabs.mts sample <voiceId> <text>   short test clip to public/audio/samples
//
// Narration itself is generated by scripts/narration.mts, which reuses tts() below.
import { mkdirSync, writeFileSync } from "node:fs";
import { resolve } from "node:path";
import { envVar } from "./env.mts";

const API = "https://api.elevenlabs.io";

function headers(): Record<string, string> {
  return { "xi-api-key": envVar("ELEVENLABS_API_KEY"), "Content-Type": "application/json" };
}

async function get(path: string): Promise<unknown> {
  const res = await fetch(`${API}${path}`, { headers: headers() });
  if (!res.ok) throw new Error(`GET ${path} failed: ${res.status} ${await res.text()}`);
  return res.json();
}

export type Alignment = {
  characters: string[];
  character_start_times_seconds: number[];
  character_end_times_seconds: number[];
};

export type TtsSettings = {
  voiceId: string;
  modelId: string;
  stability: number;
  similarityBoost: number;
  style: number;
  seed: number;
  /** ElevenLabs' own pace control, 0.7 to 1.2 (1 = the voice's natural pace). */
  speed?: number;
};

/** One text-to-speech call with character timings (for captions and cue times). */
export async function tts(
  text: string,
  s: TtsSettings,
  previousText?: string,
  nextText?: string,
): Promise<{ audio: Buffer; alignment: Alignment }> {
  const res = await fetch(
    `${API}/v1/text-to-speech/${s.voiceId}/with-timestamps?output_format=mp3_44100_128`,
    {
      method: "POST",
      headers: headers(),
      body: JSON.stringify({
        text,
        model_id: s.modelId,
        seed: s.seed,
        previous_text: previousText,
        next_text: nextText,
        voice_settings: {
          stability: s.stability,
          similarity_boost: s.similarityBoost,
          style: s.style,
          use_speaker_boost: true,
          ...(s.speed === undefined ? {} : { speed: s.speed }),
        },
      }),
    },
  );
  if (!res.ok) throw new Error(`text-to-speech failed: ${res.status} ${await res.text()}`);
  const body = (await res.json()) as { audio_base64: string; alignment: Alignment };
  return { audio: Buffer.from(body.audio_base64, "base64"), alignment: body.alignment };
}

async function main(): Promise<void> {
  const [cmd, ...args] = process.argv.slice(2);
  if (cmd === "info") {
    const s = (await get("/v1/user/subscription")) as Record<string, unknown>;
    const used = Number(s.character_count);
    const limit = Number(s.character_limit);
    console.log(`tier ${s.tier}, status ${s.status}`);
    console.log(`characters used ${used} of ${limit}, left ${limit - used}`);
    const reset = Number(s.next_character_count_reset_unix);
    if (reset) console.log(`resets ${new Date(reset * 1000).toISOString()}`);
  } else if (cmd === "voices") {
    const v = (await get("/v1/voices")) as {
      voices: { voice_id: string; name: string; category: string; labels: Record<string, string> }[];
    };
    for (const x of v.voices) {
      const l = x.labels ?? {};
      console.log(
        [x.name, x.voice_id, x.category, l.gender, l.age, l.accent, l.descriptive ?? l.description, l.use_case]
          .map((p) => p ?? "")
          .join(" | "),
      );
    }
  } else if (cmd === "models") {
    const m = (await get("/v1/models")) as {
      model_id: string;
      name: string;
      can_do_text_to_speech: boolean;
      max_characters_request_free_user?: number;
    }[];
    for (const x of m.filter((y) => y.can_do_text_to_speech)) console.log(`${x.model_id} | ${x.name}`);
  } else if (cmd === "sample") {
    const [voiceId, ...words] = args;
    const out = resolve(import.meta.dirname, "..", "public", "audio", "samples");
    mkdirSync(out, { recursive: true });
    const { audio } = await tts(words.join(" "), {
      voiceId,
      modelId: "eleven_multilingual_v2",
      stability: 0.5,
      similarityBoost: 0.75,
      style: 0,
      seed: 7,
    });
    writeFileSync(resolve(out, `${voiceId}.mp3`), audio);
    console.log(`wrote public/audio/samples/${voiceId}.mp3 (${words.join(" ").length} characters)`);
  } else {
    console.log("usage: info | voices | models | sample <voiceId> <text>");
  }
}

if (import.meta.filename === resolve(process.argv[1] ?? "")) {
  main().catch((e: unknown) => {
    console.error(e instanceof Error ? e.message : e);
    process.exit(1);
  });
}
