# Copy to .env and fill in. Never commit .env.

# Meta Model API (https://dev.meta.ai/docs/overview). A credit card must be on the account.
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1

# QuantiPhy's run_API_results.py reads OPENAI_API_KEY. When running the baseline
# against Meta's endpoint, set this to the same value as MODEL_API_KEY in your shell only.
OPENAI_API_KEY=

# Muse Spark Open on Baseten (stretch backend; confirm the base URL in Baseten's quickstart)
BASETEN_API_KEY=
BASETEN_BASE_URL=
OPEN_MODEL=meta-models/muse-spark-open-1026
LLM_BACKEND=meta_api

# Audit switch (Phase 3)
AUDIT_ENABLED=true

# Live runs and caps. Keep false locally; set true on the hosted backend for judging.
# Before any API call the backend estimates the run's cost (SAM frames x concepts x $0.0002,
# plus Muse Spark tokens) and refuses with 429 if it is above the run or study cap or the
# day's remaining budget. Disk-cache hits cost $0 and never count.
LIVE_RUNS_ENABLED=false
LIVE_MAX_CLIP_SECONDS=15
LIVE_MAX_STUDY_SECONDS=60
LIVE_RUNS_PER_IP_PER_HOUR=5
PER_RUN_CAP_USD=0.50
PER_STUDY_CAP_USD=1.50
DAILY_SPEND_CAP_USD=5.00

# Paths
CACHE_DIR=data/cache
QUANTIPHY_DIR=data/quantiphy-val
FIELD_DIR=data/field

# SAM 3.1 open-weights fallback (optional)
HF_TOKEN=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# 21st.dev Magic MCP for Claude Code (optional; export in your shell, .mcp.json reads it)
TWENTYFIRST_API_KEY=

# Web app: copy this line into web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000

# Browser origins allowed to call the API (comma-separated). Add the deployed web URL.
WEB_ORIGINS=http://localhost:3000
