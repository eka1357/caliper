# Copy to .env and fill in. Never commit .env.

# Meta Model API (https://dev.meta.ai/docs/overview)
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1

# QuantiPhy's run_API_results.py reads OPENAI_API_KEY. When running the baseline
# against Meta's endpoint, set this to the same value as MODEL_API_KEY in your shell only.
OPENAI_API_KEY=

# Spend and safety
LIVE_RUNS_ENABLED=false
PER_RUN_CAP_USD=0.10
DAILY_SPEND_CAP_USD=2.00

# Paths
CACHE_DIR=data/cache
QUANTIPHY_DIR=data/quantiphy-val
FIELD_DIR=data/field

# SAM 3.1 open-weights fallback (optional)
HF_TOKEN=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# 21st.dev Magic MCP for Claude Code (optional; export in your shell, .mcp.json reads it)
TWENTYFIRST_API_KEY=

# Web app: copy this line into web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000
